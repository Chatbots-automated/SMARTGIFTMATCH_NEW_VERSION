NEXT_PUBLIC_SITE_URL=https://smartgiftmatch.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Gift finder AI (OpenAI). Without it the finder uses the built-in scoring engine.
OPENAI_API_KEY=
# Optional: override the chat model (default gpt-5.4-mini)
OPENAI_MODEL=

# Server-only. Used by /api/cron/sync-gift-profiles to write AI gift profiles. Never expose this.
SUPABASE_SERVICE_ROLE_KEY=
# Protects the sync endpoint: send "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
